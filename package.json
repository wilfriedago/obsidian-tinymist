{
  "name": "obsidian-tinymist",
  "version": "0.4.0",
  "private": true,
  "description": "Edit, preview, and export Typst documents in Obsidian using the Tinymist language server.",
  "keywords": [
    "obsidian",
    "tinymist",
    "typst"
  ],
  "homepage": "https://community.obsidian.md/plugins/tinymist",
  "bugs": {
    "url": "https://github.com/wilfriedago/obsidian-tinymist/issues",
    "email": "oss@wilfriedago.me"
  },
  "license": "MIT",
  "author": {
    "name": "Wilfried K. AGO",
    "email": "oss@wilfriedago.me",
    "url": "https://wilfriedago.me"
  },
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/wilfriedago"
    }
  ],
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run typecheck && node esbuild.config.mjs production",
    "check:codemirror": "node scripts/check-codemirror.mjs",
    "dev": "node scripts/dev-vault.mjs && node esbuild.config.mjs",
    "dev:check": "tsc -noEmit -skipLibCheck --watch --preserveWatchOutput",
    "dev:hot-reload": "node scripts/install-hot-reload.mjs",
    "dev:setup": "node scripts/dev-vault.mjs",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@codemirror/legacy-modes": "6.5.4",
    "codemirror-lang-typst": "0.6.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lezer/highlight": "1.2.5",
    "@types/node": "^26.6.3",
    "esbuild": "0.28.2",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\"",
    "pre-push": "if grep -q ' refs/heads/develop '; then pnpm build; fi"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.5.1"
}
